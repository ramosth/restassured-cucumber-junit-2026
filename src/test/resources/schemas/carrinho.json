{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Carrinho (GET /carrinhos/{id})",
  "type": "object",
  "required": ["produtos", "precoTotal", "quantidadeTotal", "idUsuario", "_id"],
  "additionalProperties": false,
  "properties": {
    "produtos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["idProduto", "quantidade", "precoUnitario"],
        "additionalProperties": false,
        "properties": {
          "idProduto": { "type": "string", "pattern": "^[a-zA-Z0-9]{16}$" },
          "quantidade": { "type": "integer", "minimum": 1 },
          "precoUnitario": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "precoTotal": { "type": "integer", "minimum": 0 },
    "quantidadeTotal": { "type": "integer", "minimum": 0 },
    "idUsuario": { "type": "string", "pattern": "^[a-zA-Z0-9]{16}$" },
    "_id": { "type": "string", "pattern": "^[a-zA-Z0-9]{16}$" }
  }
}