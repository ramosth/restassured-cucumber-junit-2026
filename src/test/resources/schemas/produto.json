{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Produto (GET /produtos/{id})",
    "type": "object",
    "required": [
        "nome",
        "preco",
        "descricao",
        "quantidade",
        "_id"
    ],
    "additionalProperties": false,
    "properties": {
        "nome": {
            "type": "string",
            "minLength": 1
        },
        "preco": {
            "type": "integer",
            "minimum": 1
        },
        "descricao": {
            "type": "string",
            "minLength": 1
        },
        "quantidade": {
            "type": "integer",
            "minimum": 0
        },
        "imagem": {
            "type": "string"
        },
        "_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9]{16}$"
        }
    }
}